object ApiClient {

    private const val BASE_URL =
        "https://your-domain.com/api/"

    val api: SocialApi by lazy {

        Retrofit.Builder()
            .baseUrl(BASE_URL)
            .addConverterFactory(
                GsonConverterFactory.create()
            )
            .build()
            .create(SocialApi::class.java)
    }
}
